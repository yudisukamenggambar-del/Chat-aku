  <title>Chat Sekarang | WhatsApp</title>
  <style>
    :root { --green:#075e54; --bright:#25d366; --ink:#182b28; --muted:#687a76; }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center;
      padding: 24px; font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--ink); background: linear-gradient(145deg, #e8f5f0, #f7fbf9 55%, #e4f0ed);
    }
    .card {
      width: min(100%, 420px); padding: 34px 28px 28px; text-align: center;
      background: rgba(255,255,255,.96); border: 1px solid #dce9e5;
      border-radius: 24px; box-shadow: 0 18px 55px rgba(7,94,84,.12);
    }
    .logo {
      width: 76px; height: 76px; margin: 0 auto 18px; border-radius: 50%;
      display: grid; place-items: center; background: #e4f8ec; color: var(--green);
    }
    .logo svg { width: 43px; height: 43px; }
    .badge {
      display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px;
      border-radius: 99px; background: #effaf3; color: #147d4b;
      font-size: 12px; font-weight: 700; letter-spacing: .3px;
    }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: #25d366; }
    h1 { margin: 18px 0 10px; font-size: clamp(25px, 7vw, 31px); line-height: 1.15; letter-spacing: -.7px; }
    .description { margin: 0 auto 24px; max-width: 300px; color: var(--muted); font-size: 15px; line-height: 1.65; }
    .phone { margin-bottom: 22px; font-size: 15px; font-weight: 700; letter-spacing: .4px; }
    .button {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; min-height: 56px; padding: 15px 18px; border: 0; border-radius: 14px;
      background: var(--bright); color: #073b28; text-decoration: none;
      font-size: 16px; font-weight: 800; box-shadow: 0 8px 18px rgba(37,211,102,.22);
      transition: transform .15s ease, filter .15s ease;
    }
    .button:hover { filter: brightness(.97); transform: translateY(-1px); }
    .button:focus-visible { outline: 3px solid #075e54; outline-offset: 3px; }
    .button svg { width: 22px; height: 22px; flex: 0 0 auto; }
    .note { margin: 18px 0 0; color: #81908c; font-size: 12px; line-height: 1.5; }
    footer { margin-top: 24px; color: #91a09c; font-size: 11px; }
  </style>
</head>
